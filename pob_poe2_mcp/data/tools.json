[
  {
    "name": "pob_catalog",
    "description": "Каталог исходного Lua: точные ID камней, классов, узлов, настроек и слотов. Пагинация; доступен до создания сборки.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "gems",
            "classes",
            "nodes",
            "config",
            "slots",
            "bases"
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
