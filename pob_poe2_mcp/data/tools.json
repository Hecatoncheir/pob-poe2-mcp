  {
    "name": "pob_render_image",
    "description": "Создать PNG сборки: сводка, дерево, все характеристики, камни, предметы, условия, заметки, предупреждения или полный отчёт. Дерево отрисовывает оригинальный Lua PassiveTreeView с текстурами PoB, рамками, фонами и дугами; zoom масштабирует всё вместе, подписи showLabels по умолчанию выключены. Связи класса с восхождением скрыты. Сборка и файлы PoB не изменяются. Изображение возвращается прямо в MCP. Длинные разделы имеют страницы: смотрите pages. Для node/item нужен id из каталога/отчёта. treeScope: allocated или full; query фильтрует текст или выбирает область дерева.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "enum": [
            "overview",
            "tree",
            "stats",
            "skills",
            "items",
            "config",
            "notes",
            "warnings",
            "node",
            "item",
            "all"
          ]
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "width": {
          "type": "integer",
          "minimum": 640,
          "maximum": 2400
        },
        "height": {
          "type": "integer",
          "minimum": 480,
          "maximum": 2400
        },
        "treeScope": {
          "type": "string",
          "enum": [
            "allocated",
            "full"
          ]
        },
        "showLabels": {
          "type": "boolean"
        },
        "zoom": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 8
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
